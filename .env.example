# Copy this file to .env and fill in your key.
# If GEMINI_API_KEY is left blank, the app runs in MOCK MODE:
# retrieval + fallback logic still work fully, but the LLM answer is a placeholder.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=cloudsync_docs

CHUNK_SIZE=800
CHUNK_OVERLAP=120

TOP_K=4
DISTANCE_THRESHOLD=0.75

DOCS_DIR=./data/docs
